# ============================================================
#  PURA — pengaturan rahasia. Salin file ini menjadi ".env"
#  lalu isi nilainya. JANGAN pernah mengunggah file .env ke GitHub.
#  Di Vercel, isi nilai yang sama di Settings → Environment Variables.
# ============================================================

# Alamat database PostgreSQL (dari Neon: tombol "Connect" → salin "Connection string").
# Pakai alamat "pooled" (ada kata -pooler) untuk aplikasi.
DATABASE_URL="postgresql://user:password@ep-contoh-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# (Opsional) Alamat database langsung tanpa "-pooler", dipakai saat membuat/memperbarui tabel.
# Jika dikosongkan, DATABASE_URL yang dipakai.
DATABASE_URL_UNPOOLED=""

# Email akun Admin Utama. Hanya email ini yang boleh dipakai di halaman /setup.
# Admin Utama masuk dengan Google atau tautan email memakai alamat ini.
ADMIN_EMAIL="email-anda@contoh.com"

# Kode rahasia untuk halaman /setup (sekali pakai). Minimal 16 karakter acak.
# Buat dengan perintah:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SETUP_TOKEN=""

# Alamat situs (dipakai di tautan email). Contoh: https://pura-anda.vercel.app
APP_URL=""

# ---- Masuk dengan Google (gratis) — lihat docs/PANDUAN.md bagian "Login Google" ----
# Redirect URI yang didaftarkan di Google Cloud:  https://ALAMAT-SITUS/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Kirim email tautan masuk (Brevo, gratis 300 email/hari) — lihat docs/PANDUAN.md ----
# Jika SMTP_HOST kosong: di laptop tautan tampil di layar; di server online, masuk lewat email dimatikan.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Pengirim email. Alamat ini harus sudah diverifikasi di Brevo (Senders).
EMAIL_FROM="PURA <alamat-anda@contoh.com>"

# Umat boleh membuat akun sendiri (Google / tautan email)? "true" (bawaan) atau "false".
# Peran pengurus TIDAK pernah didapat sendiri — hanya diberikan Admin Utama di Back Office.
UMAT_REGISTRATION="true"

# Kode rahasia untuk email ringkasan harian (dipanggil otomatis oleh Vercel Cron).
# Buat dengan perintah yang sama seperti SETUP_TOKEN.
CRON_SECRET=""

# Zona waktu untuk tanggal "hari ini" di server. WITA = Asia/Makassar, WIB = Asia/Jakarta, WIT = Asia/Jayapura.
APP_TIMEZONE="Asia/Makassar"
